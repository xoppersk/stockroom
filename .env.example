# Stockroom — copy this file to .env.local and fill in real values.
# Get the Supabase values from your Supabase project: Project Settings → API.
# Get the Stripe values from your Stripe dashboard (Developers → API keys,
# Developers → Webhooks). Use TEST-mode keys for local development.
#
# REPLACE_ME — these placeholders are NOT real credentials. They only exist so
# the shape of the file is obvious. Never commit real keys.

# Public project URL, e.g. https://abcdefghijklmnop.supabase.co
NEXT_PUBLIC_SUPABASE_URL=https://REPLACE_ME.supabase.co

# Public anon key (safe to expose in the browser; RLS still applies)
NEXT_PUBLIC_SUPABASE_ANON_KEY=REPLACE_ME_ANON_KEY

# Service-role key — server only, NEVER expose to the browser. Used for the
# staff invite flow (auth.admin) and the Stripe webhook route.
SUPABASE_SERVICE_ROLE_KEY=REPLACE_ME_SERVICE_ROLE_KEY

# Stripe secret key (test mode), e.g. sk_test_...
STRIPE_SECRET_KEY=REPLACE_ME_STRIPE_SECRET_KEY

# Stripe publishable key (test mode), e.g. pk_test_...
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=REPLACE_ME_STRIPE_PUBLISHABLE_KEY

# Stripe webhook signing secret (test mode), e.g. whsec_...
# From Stripe Dashboard → Developers → Webhooks → the /api/webhooks/stripe
# endpoint (or `stripe listen` when developing locally).
STRIPE_WEBHOOK_SECRET=REPLACE_ME_STRIPE_WEBHOOK_SECRET

# Base URL of the app, used to build email redirect links (magic link,
# invite, password reset). Defaults to window.location.origin when unset —
# set it explicitly for preview/production deployments.
NEXT_PUBLIC_APP_URL=http://localhost:3000
